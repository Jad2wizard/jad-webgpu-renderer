{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"declaration": false,
		"types": ["node"],
		"paths": {
			"@shared/*": ["./shared/*"]
		},
		"baseUrl": ".",
		"outDir": "dist/server"
	},
	"include": ["server/**/*.ts", "shared/**/*.ts"]
}
