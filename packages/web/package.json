{
	"name": "@webgpu-gmap/web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "concurrently -n client,server -c blue,green \"webpack serve\" \"tsx server/start.ts\"",
		"dev:client": "webpack serve",
		"dev:server": "tsx watch server/start.ts",
		"build": "webpack --mode production",
		"start": "NODE_ENV=production node --import tsx server/start.ts",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:seed": "tsx server/db/seed.ts"
	},
	"dependencies": {
