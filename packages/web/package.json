		"bcryptjs": "^2.4.3",
		"better-sqlite3": "^11.7.0",
		"cors": "^2.8.5",
		"drizzle-orm": "^0.40.1",
		"element-plus": "^2.9.7",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"langchain": "^0.3.20",
		"marked": "^15.0.8",
		"multer": "^1.4.5-lts.1",
		"ofetch": "^1.4.1",
		"pinia": "^2.3.0",
		"uuid": "^10.0.0",
