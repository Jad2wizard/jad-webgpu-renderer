{
  "name": "@webgpu-gmap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"vite\" \"tsx server/start.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/start.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "start": "NODE_ENV=production node --import tsx server/start.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx server/db/seed.ts"
  },
  "dependencies": {
    "@webgpu-gmap/map": "*",
    "@webgpu-gmap/renderer": "*",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "@vueuse/core": "^12.5.0",
    "element-plus": "^2.9.7",
    "@element-plus/icons-vue": "^2.3.1",
    "ofetch": "^1.4.1",
    "marked": "^15.0.8",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "@langchain/core": "^0.3.40",
    "@langchain/openai": "^0.4.6",
    "langchain": "^0.3.20",
    "zod": "^3.24.2",
    "drizzle-orm": "^0.40.1",
    "better-sqlite3": "^11.7.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "vite": "^6.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.4.0",
    "vue-tsc": "^2.2.8",
    "@types/express": "^5.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "drizzle-kit": "^0.30.5",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.20",
    "tsx": "^4.19.3",
    "concurrently": "^9.1.2"
  }
}
