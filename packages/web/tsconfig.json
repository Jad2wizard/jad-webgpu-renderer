{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"sourceMap": true,
		"lib": ["dom", "dom.iterable", "es2022"],
		"declaration": false,
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./shared/*"],
			"@webgpu-gmap/map": ["../map/lib/application/index.js"]
		},
		"baseUrl": ".",
		"outDir": "dist/client"
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "shared/**/*.ts"]
}
