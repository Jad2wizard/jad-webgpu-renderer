{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./lib",
		"declarationDir": "./typings",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"baseUrl": ".",
		"paths": {
			"@map/*": ["src/*"]
		},
		"jsx": "react-jsx",
		"lib": ["dom", "dom.iterable", "esnext"]
	},
	"include": ["./src/**/*"],
	"exclude": ["./typings/**/*", "./src/iife-entry.ts"]
}
